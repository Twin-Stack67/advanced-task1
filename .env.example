# Frontend: omit this in production when using the same-origin Vercel API function.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Backend: required for local development and in Vercel's Project Environment Variables.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated browser origins when the frontend and backend are hosted separately.
# CORS_ORIGINS=https://your-frontend-domain.vercel.app
